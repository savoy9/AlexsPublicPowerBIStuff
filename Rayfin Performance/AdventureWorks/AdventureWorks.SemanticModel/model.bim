        "lineageTag": "e2dfc242-077a-4be1-95fd-8bc86975819f",
        "partitions": [
          {
            "name": "FactInternetSales",
            "mode": "directLake",
            "source": {
              "entityName": "FactInternetSales",
              "expressionSource": "DirectLake - OneLake",
              "type": "entity"
            }
          }
        ],
        "sourceLineageTag": "[dbo].[FactInternetSales]",
        "measures": [
          {
            "name": "Total Sales",
            "expression": [
              "SUM('FactInternetSales'[SalesAmount])"
            ],
            "displayFolder": "Report",
            "lineageTag": "e0c76822-29ce-4bd5-b032-5179af19643a",
            "formatString": "#,0.00;(#,0.00);0.00",
            "description": "Original official AdventureWorksDW Internet SalesAmount. Excludes freight, tax and reseller sales."
          },
          {
            "name": "Total Cost",
            "expression": [
              "SUM('FactInternetSales'[TotalProductCost])"
            ],
            "displayFolder": "Report",
            "lineageTag": "c68c5410-f355-4e28-a2c6-3b6e09aaa674",
            "formatString": "#,0.00;(#,0.00);0.00"
          },
          {
            "name": "Gross Profit",
            "expression": [
              "[Total Sales] - [Total Cost]"
            ],
            "displayFolder": "Report",
            "lineageTag": "ce9f1176-6696-4bab-b2aa-2acccc3ab140",
            "formatString": "#,0.00;(#,0.00);0.00"
          },
          {
            "name": "Gross Margin",
            "expression": [
              "DIVIDE([Gross Profit], [Total Sales])"
            ],
            "displayFolder": "Report",
            "lineageTag": "adf5463d-0023-40f2-983b-88749dfd17dc",
            "formatString": "0.0%;(0.0%);0.0%"
          },
          {
            "name": "Order Count",
            "expression": [
              "DISTINCTCOUNT('FactInternetSales'[SalesOrderNumber])"
            ],
            "displayFolder": "Report",
            "lineageTag": "c1329626-6339-4d88-99a2-27ebfd430de9",
            "formatString": "#,0"
          },
          {
            "name": "Units Sold",
            "expression": [
              "SUM('FactInternetSales'[OrderQuantity])"
            ],
            "displayFolder": "Report",
            "lineageTag": "bab32a43-7b38-4f84-8e67-0a20392e5604",
            "formatString": "#,0"
          },
          {
            "name": "Order Lines",
            "expression": [
              "COUNTROWS('FactInternetSales')"
            ],
            "displayFolder": "Report",
            "lineageTag": "2265fbfe-f056-45d7-a031-65c9de64157e",
            "formatString": "#,0"
          },
          {
            "name": "AOV",
            "expression": [
              "DIVIDE([Total Sales], [Order Count])"
            ],
            "displayFolder": "Report",
            "lineageTag": "e44b7fdb-b953-4dcc-b0d6-27a4faefd8f9",
            "formatString": "#,0.00;(#,0.00);0.00"
          },
          {
            "name": "Selected YM",
            "expression": [
              "SELECTEDVALUE('DimDate'[YearMonthKey])"
            ],
            "displayFolder": "Report",
            "lineageTag": "8a34e096-615d-4890-b945-0aeca3fdfc7d",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "First Source Date Key",
            "expression": [
              "CALCULATE(MIN('FactInternetSales'[OrderDateKey]), REMOVEFILTERS())"
            ],
            "displayFolder": "Report",
            "lineageTag": "239710cc-f074-44f8-8b58-c1ff25e0bbbe",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Last Source Date Key",
            "expression": [
              "CALCULATE(MAX('FactInternetSales'[OrderDateKey]), REMOVEFILTERS())"
            ],
            "displayFolder": "Report",
            "lineageTag": "8b40fc10-60b7-45bc-9b32-f364388ba33f",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Source Last Date",
            "expression": [
              "VAR k = [Last Source Date Key]",
              "RETURN DATE(INT(k/10000),MOD(INT(k/100),100),MOD(k,100))"
            ],
            "displayFolder": "Report",
            "lineageTag": "df4009f1-54f0-4d8a-9335-0e418492cb57",
            "formatString": "dd mmm yyyy"
          },
          {
            "name": "Prev YM",
            "expression": [
              "VAR ym = [Selected YM]",
              "RETURN IF(NOT ISBLANK(ym), IF(MOD(ym,100)=1,(INT(ym/100)-1)*100+12,ym-1))"
            ],
            "displayFolder": "Report",
            "lineageTag": "4eef1e72-ce72-4f34-96a0-31a93bb24ac1",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Prior Year YM",
            "expression": [
              "IF(NOT ISBLANK([Selected YM]),[Selected YM]-100)"
            ],
            "displayFolder": "Report",
            "lineageTag": "8178a087-e4a0-44dd-8f90-fda31645ea92",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Is Partial Selected Month",
            "expression": [
              "VAR ym = [Selected YM]",
              "VAR lo = [First Source Date Key]",
              "VAR hi = [Last Source Date Key]",
              "VAR lastDay = IF(NOT ISBLANK(ym),DAY(EOMONTH(DATE(INT(ym/100),MOD(ym,100),1),0)))",
              "RETURN NOT ISBLANK(ym) &&",
              "    (ym<INT(lo/100) || ym>INT(hi/100) ||",
              "     (ym=INT(lo/100) && MOD(lo,100)>1) ||",
              "     (ym=INT(hi/100) && MOD(hi,100)<lastDay))"
            ],
            "displayFolder": "Report",
            "lineageTag": "3d4313b0-21bb-476f-a6ba-497214292737",
            "isHidden": true
          },
          {
            "name": "Is Partial Prev Month",
            "expression": [
              "VAR ym = [Prev YM]",
              "VAR lo = [First Source Date Key]",
              "VAR hi = [Last Source Date Key]",
              "VAR lastDay = IF(NOT ISBLANK(ym),DAY(EOMONTH(DATE(INT(ym/100),MOD(ym,100),1),0)))",
              "RETURN NOT ISBLANK(ym) &&",
              "    (ym<INT(lo/100) || ym>INT(hi/100) ||",
              "     (ym=INT(lo/100) && MOD(lo,100)>1) ||",
              "     (ym=INT(hi/100) && MOD(hi,100)<lastDay))"
            ],
            "displayFolder": "Report",
            "lineageTag": "048dcd45-5831-4d61-bfbb-4c351ab7eb04",
            "isHidden": true
          },
          {
            "name": "Is Partial Prior Year Month",
            "expression": [
              "VAR ym = [Prior Year YM]",
              "VAR lo = [First Source Date Key]",
              "VAR hi = [Last Source Date Key]",
              "VAR lastDay = IF(NOT ISBLANK(ym),DAY(EOMONTH(DATE(INT(ym/100),MOD(ym,100),1),0)))",
              "RETURN NOT ISBLANK(ym) &&",
              "    (ym<INT(lo/100) || ym>INT(hi/100) ||",
              "     (ym=INT(lo/100) && MOD(lo,100)>1) ||",
              "     (ym=INT(hi/100) && MOD(hi,100)<lastDay))"
            ],
            "displayFolder": "Report",
            "lineageTag": "196559fa-cbfe-41b9-b16b-65e14e33f6d1",
            "isHidden": true
          },
          {
            "name": "Sales PM",
            "expression": [
              "VAR ym = [Prev YM]",
              "RETURN IF(NOT ISBLANK(ym),CALCULATE([Total Sales],REMOVEFILTERS('DimDate'),'DimDate'[YearMonthKey]=ym))"
            ],
            "displayFolder": "Report",
            "lineageTag": "2aacd36a-ea32-4fbc-8730-c5c468a28a3d",
            "formatString": "#,0.00;(#,0.00);0.00"
          },
          {
            "name": "Orders PM",
            "expression": [
              "VAR ym = [Prev YM]",
              "RETURN IF(NOT ISBLANK(ym),CALCULATE([Order Count],REMOVEFILTERS('DimDate'),'DimDate'[YearMonthKey]=ym))"
            ],
            "displayFolder": "Report",
            "lineageTag": "e17a0936-be44-4ef8-85d5-6f8013567d12",
            "formatString": "#,0"
          },
          {
            "name": "Sales PY",
            "expression": [
              "VAR ym = [Prior Year YM]",
              "RETURN IF(NOT ISBLANK(ym),CALCULATE([Total Sales],REMOVEFILTERS('DimDate'),'DimDate'[YearMonthKey]=ym))"
            ],
            "displayFolder": "Report",
            "lineageTag": "334cc8cd-37c2-46a9-8885-b41fdb5b8ead",
            "formatString": "#,0.00;(#,0.00);0.00"
          },
          {
            "name": "Sales MoM %",
            "expression": [
              "IF(NOT [Is Partial Selected Month] && NOT [Is Partial Prev Month] && NOT ISBLANK([Total Sales]),",
              "   DIVIDE([Total Sales]-[Sales PM],[Sales PM]))"
            ],
            "displayFolder": "Report",
            "lineageTag": "f8591ba2-a856-4507-afa5-d84a9a8f3f83",
            "formatString": "0.0%;(0.0%);0.0%"
          },
          {
            "name": "Orders MoM %",
            "expression": [
              "IF(NOT [Is Partial Selected Month] && NOT [Is Partial Prev Month] && NOT ISBLANK([Order Count]),",
              "   DIVIDE([Order Count]-[Orders PM],[Orders PM]))"
            ],
            "displayFolder": "Report",
            "lineageTag": "989ffce0-f4e8-4dd5-a788-6fb953355431",
            "formatString": "0.0%;(0.0%);0.0%"
          },
          {
            "name": "Sales YoY %",
            "expression": [
              "IF(NOT [Is Partial Selected Month] && NOT [Is Partial Prior Year Month] && NOT ISBLANK([Total Sales]),",
              "   DIVIDE([Total Sales]-[Sales PY],[Sales PY]))"
            ],
            "displayFolder": "Report",
            "lineageTag": "57d45111-06e0-4d6f-b167-908037ad9122",
            "formatString": "0.0%;(0.0%);0.0%"
          },
          {
            "name": "Sales Compare Text",
            "expression": [
              "VAR ym = [Prev YM]",
              "VAR change = [Sales MoM %]",
              "VAR label = IF(NOT ISBLANK(ym),FORMAT(DATE(INT(ym/100),MOD(ym,100),1),\"mmm yyyy\"))",
              "RETURN SWITCH(TRUE(),",
              "    ISBLANK([Selected YM]) || ISBLANK([Total Sales]),BLANK(),",
              "    ym<INT([First Source Date Key]/100),\"No comparison: no earlier data\",",
              "    [Is Partial Selected Month],\"No comparison: selected month partial\",",
              "    [Is Partial Prev Month],\"No comparison: prior month partial\",",
              "    ISBLANK([Sales PM]) || [Sales PM]=0,\"No comparison: no prior matching sales\",",
              "    IF(change>=0,\"+\",\"\") & FORMAT(change,\"0.0%\") & \" vs \" & label)"
            ],
            "displayFolder": "Report",
            "lineageTag": "e37826a6-1dd2-4525-adb9-6ecc2320d322"
          },
          {
            "name": "Orders Compare Text",
            "expression": [
              "VAR ym = [Prev YM]",
              "VAR change = [Orders MoM %]",
              "VAR label = IF(NOT ISBLANK(ym),FORMAT(DATE(INT(ym/100),MOD(ym,100),1),\"mmm yyyy\"))",
              "RETURN SWITCH(TRUE(),",
              "    ISBLANK([Selected YM]) || ISBLANK([Order Count]),BLANK(),",
              "    ym<INT([First Source Date Key]/100),\"No comparison: no earlier data\",",
              "    [Is Partial Selected Month],\"No comparison: selected month partial\",",
              "    [Is Partial Prev Month],\"No comparison: prior month partial\",",
              "    ISBLANK([Orders PM]) || [Orders PM]=0,\"No comparison: no prior matching sales\",",
              "    IF(change>=0,\"+\",\"\") & FORMAT(change,\"0.0%\") & \" vs \" & label)"
            ],
            "displayFolder": "Report",
            "lineageTag": "2801f867-86f6-4b72-b5b4-2e7e36f84ad6"
          },
          {
            "name": "Sales YoY Compare Text",
            "expression": [
              "VAR ym = [Prior Year YM]",
              "VAR change = [Sales YoY %]",
              "VAR label = IF(NOT ISBLANK(ym),FORMAT(DATE(INT(ym/100),MOD(ym,100),1),\"mmm yyyy\"))",
              "RETURN SWITCH(TRUE(),",
              "    ISBLANK([Selected YM]) || ISBLANK([Total Sales]),BLANK(),",
              "    ym<INT([First Source Date Key]/100),\"No comparison: no earlier data\",",
              "    [Is Partial Selected Month],\"No comparison: selected month partial\",",
              "    [Is Partial Prior Year Month],\"No comparison: prior month partial\",",
              "    ISBLANK([Sales PY]) || [Sales PY]=0,\"No comparison: no prior matching sales\",",
              "    IF(change>=0,\"+\",\"\") & FORMAT(change,\"0.0%\") & \" vs \" & label)"
            ],
            "displayFolder": "Report",
            "lineageTag": "3c912dd4-6c12-4478-9b98-69db4f57c892"
          },
          {
            "name": "Partial Month Text",
            "expression": [
              "VAR ym = [Selected YM]",
              "VAR lo = [First Source Date Key]",
              "VAR hi = [Last Source Date Key]",
              "RETURN IF([Is Partial Selected Month],",
              "    IF(ym=INT(lo/100),\"Partial month - data starts \" & FORMAT(DATE(INT(lo/10000),MOD(INT(lo/100),100),MOD(lo,100)),\"dd mmm yyyy\"),",
              "       IF(ym=INT(hi/100),\"Partial month - data through \" & FORMAT([Source Last Date],\"dd mmm yyyy\"),\"Outside source coverage\")))"
            ],
            "displayFolder": "Report",
            "lineageTag": "4b51f7af-2311-42ca-b9b0-4181b54260cf"
          },
          {
            "name": "Trend Window",
            "expression": [
              "VAR hi = [Last Source Date Key]",
              "VAR endMonth = DATE(INT(hi/10000),MOD(INT(hi/100),100),1)",
              "VAR startMonth = EDATE(endMonth,-11)",
              "VAR ym = SELECTEDVALUE('DimDate'[YearMonthKey])",
              "RETURN IF(NOT ISBLANK(ym) && ym>=YEAR(startMonth)*100+MONTH(startMonth) && ym<=INT(hi/100),1)"
            ],
            "displayFolder": "Report",
            "lineageTag": "2c208920-749d-4337-af93-d483f897c4e2",
            "formatString": "0"
          },
          {
            "name": "Detail Sort",
            "expression": [
              "MIN('FactInternetSales'[DetailSortKey])"
            ],
            "displayFolder": "Report",
            "lineageTag": "d6ad3ffc-0245-4762-b737-af855ef70ad9",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Detail Count Text",
            "expression": [
              "VAR n = [Order Lines]",
              "RETURN \"Showing \" & FORMAT(MIN(500,COALESCE(n,0)),\"#,0\") & \" of \" & FORMAT(COALESCE(n,0),\"#,0\") & \" order lines\""
            ],
            "displayFolder": "Report",
            "lineageTag": "8044fef3-2797-4a8b-b503-b73c8c2a754a"
          }
        ]
      },
