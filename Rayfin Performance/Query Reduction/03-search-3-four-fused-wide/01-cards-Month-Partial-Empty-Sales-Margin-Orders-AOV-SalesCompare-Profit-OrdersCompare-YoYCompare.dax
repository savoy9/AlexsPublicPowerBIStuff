DEFINE
MEASURE 'FactInternetSales'[AW Selected Month] = 
		(/* USER DAX BEGIN */
VAR ym=SELECTEDVALUE(DimDate[YearMonthKey]) RETURN IF(ISBLANK(ym),"Select one month",FORMAT(DATE(INT(ym/100),MOD(ym,100),1),"MMM yyyy"))
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Partial Badge] = 
		(/* USER DAX BEGIN */
COALESCE([Partial Month Text],"")
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Empty Text] = 
		(/* USER DAX BEGIN */
IF(COALESCE([Order Lines],0)=0,"No sales for this selection","")
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Card Sales] = 
		(/* USER DAX BEGIN */
VAR v=[Total Sales] RETURN IF(ISBLANK(v),"—",IF(ABS(v)>=1000000,FORMAT(v/1000000,"$0.0")&"M",IF(ABS(v)>=1000,FORMAT(v/1000,"$0.0")&"K",FORMAT(v,"$0.00"))))
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Card Margin] = 
		(/* USER DAX BEGIN */
IF(ISBLANK([Gross Margin]),"—",FORMAT([Gross Margin],"0.0%"))
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Card Orders] = 
		(/* USER DAX BEGIN */
IF(ISBLANK([Order Count]),"—",FORMAT([Order Count],"#,0"))
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Card AOV] = 
		(/* USER DAX BEGIN */
IF(ISBLANK([AOV]),"—",FORMAT([AOV],"$#,0.00"))
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Sales Compare] = 
		(/* USER DAX BEGIN */
IF(ISBLANK([Sales MoM %]),[Sales Compare Text],IF([Sales MoM %]>=0,"▲ ","▼ ")&[Sales Compare Text])
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Orders Compare] = 
		(/* USER DAX BEGIN */
IF(ISBLANK([Orders MoM %]),[Orders Compare Text],IF([Orders MoM %]>=0,"▲ ","▼ ")&[Orders Compare Text])
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW YoY Compare] = 
		(/* USER DAX BEGIN */
IF(ISBLANK([Sales YoY %]),[Sales YoY Compare Text],IF([Sales YoY %]>=0,"▲ ","▼ ")&[Sales YoY Compare Text])
/* USER DAX END */)
VAR __CardsFilter = TREATAS({"2013-12"}, 'DimDate'[YearMonth])

EVALUATE
CROSSJOIN(SUMMARIZECOLUMNS(__CardsFilter, "__card_Month", IGNORE('FactInternetSales'[AW Selected Month]), "__card_Partial", IGNORE('FactInternetSales'[AW Partial Badge]), "__card_Empty", IGNORE('FactInternetSales'[AW Empty Text]), "__card_Sales", IGNORE('FactInternetSales'[AW Card Sales]), "__card_Margin", IGNORE('FactInternetSales'[AW Card Margin]), "__card_Orders", IGNORE('FactInternetSales'[AW Card Orders]), "__card_AOV", IGNORE('FactInternetSales'[AW Card AOV]), "__card_Profit", IGNORE('FactInternetSales'[Gross Profit])), CALCULATETABLE(

VAR selectedYM = [Selected YM]
VAR minimumYM = INT([First Source Date Key]/100)
VAR selectedPartial = [Is Partial Selected Month]
VAR pmYM = [Prev YM]
VAR pyYM = [Prior Year YM]
VAR pmPartial = [Is Partial Prev Month]
VAR pyPartial = [Is Partial Prior Year Month]
VAR nowSales = [Total Sales]
VAR nowOrders = [Order Count]
VAR pmSales = [Sales PM]
VAR pmOrders = [Orders PM]
VAR pySales = [Sales PY]
VAR __valueSalesCompare = 
VAR change = IF(NOT selectedPartial && NOT pmPartial && NOT ISBLANK(nowSales),
    DIVIDE(nowSales-pmSales,pmSales))
VAR label = IF(NOT ISBLANK(pmYM),FORMAT(DATE(INT(pmYM/100),MOD(pmYM,100),1),"mmm yyyy"))
VAR resultText = SWITCH(TRUE(),
    ISBLANK(selectedYM) || ISBLANK(nowSales),BLANK(),
    pmYM<minimumYM,"No comparison: no earlier data",
    selectedPartial,"No comparison: selected month partial",
    pmPartial,"No comparison: prior month partial",
    ISBLANK(pmSales) || pmSales=0,"No comparison: no prior matching sales",
    IF(change>=0,"+","") & FORMAT(change,"0.0%") & " vs " & label)
RETURN IF(ISBLANK(change),resultText,IF(change>=0,"▲ ","▼ ") & resultText)
VAR __valueOrdersCompare = 
VAR change = IF(NOT selectedPartial && NOT pmPartial && NOT ISBLANK(nowOrders),
    DIVIDE(nowOrders-pmOrders,pmOrders))
VAR label = IF(NOT ISBLANK(pmYM),FORMAT(DATE(INT(pmYM/100),MOD(pmYM,100),1),"mmm yyyy"))
VAR resultText = SWITCH(TRUE(),
    ISBLANK(selectedYM) || ISBLANK(nowOrders),BLANK(),
    pmYM<minimumYM,"No comparison: no earlier data",
    selectedPartial,"No comparison: selected month partial",
    pmPartial,"No comparison: prior month partial",
    ISBLANK(pmOrders) || pmOrders=0,"No comparison: no prior matching sales",
    IF(change>=0,"+","") & FORMAT(change,"0.0%") & " vs " & label)
RETURN IF(ISBLANK(change),resultText,IF(change>=0,"▲ ","▼ ") & resultText)
VAR __valueYoYCompare = 
VAR change = IF(NOT selectedPartial && NOT pyPartial && NOT ISBLANK(nowSales),
    DIVIDE(nowSales-pySales,pySales))
VAR label = IF(NOT ISBLANK(pyYM),FORMAT(DATE(INT(pyYM/100),MOD(pyYM,100),1),"mmm yyyy"))
VAR resultText = SWITCH(TRUE(),
    ISBLANK(selectedYM) || ISBLANK(nowSales),BLANK(),
    pyYM<minimumYM,"No comparison: no earlier data",
    selectedPartial,"No comparison: selected month partial",
    pyPartial,"No comparison: prior month partial",
    ISBLANK(pySales) || pySales=0,"No comparison: no prior matching sales",
    IF(change>=0,"+","") & FORMAT(change,"0.0%") & " vs " & label)
RETURN IF(ISBLANK(change),resultText,IF(change>=0,"▲ ","▼ ") & resultText)
RETURN ROW("__card_SalesCompare", __valueSalesCompare, "__card_OrdersCompare", __valueOrdersCompare, "__card_YoYCompare", __valueYoYCompare),
__CardsFilter))