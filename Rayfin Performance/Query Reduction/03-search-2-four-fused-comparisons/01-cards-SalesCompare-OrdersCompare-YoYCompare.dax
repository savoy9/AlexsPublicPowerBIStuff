DEFINE
VAR __CardsFilter = TREATAS({"2013-12"}, 'DimDate'[YearMonth])

EVALUATE
CALCULATETABLE(

VAR selectedYM = [Selected YM]
VAR minimumYM = INT([First Source Date Key]/100)
VAR selectedPartial = [Is Partial Selected Month]
VAR pmYM = [Prev YM]
VAR pyYM = [Prior Year YM]
VAR pmPartial = [Is Partial Prev Month]
VAR pyPartial = [Is Partial Prior Year Month]
VAR nowSales = [Total Sales]
VAR nowOrders = [Order Count]
VAR pmSales = [Sales PM]
VAR pmOrders = [Orders PM]
VAR pySales = [Sales PY]
VAR __valueSalesCompare = 
VAR change = IF(NOT selectedPartial && NOT pmPartial && NOT ISBLANK(nowSales),
    DIVIDE(nowSales-pmSales,pmSales))
VAR label = IF(NOT ISBLANK(pmYM),FORMAT(DATE(INT(pmYM/100),MOD(pmYM,100),1),"mmm yyyy"))
VAR resultText = SWITCH(TRUE(),
    ISBLANK(selectedYM) || ISBLANK(nowSales),BLANK(),
    pmYM<minimumYM,"No comparison: no earlier data",
    selectedPartial,"No comparison: selected month partial",
    pmPartial,"No comparison: prior month partial",
    ISBLANK(pmSales) || pmSales=0,"No comparison: no prior matching sales",
    IF(change>=0,"+","") & FORMAT(change,"0.0%") & " vs " & label)
RETURN IF(ISBLANK(change),resultText,IF(change>=0,"▲ ","▼ ") & resultText)
VAR __valueOrdersCompare = 
VAR change = IF(NOT selectedPartial && NOT pmPartial && NOT ISBLANK(nowOrders),
    DIVIDE(nowOrders-pmOrders,pmOrders))
VAR label = IF(NOT ISBLANK(pmYM),FORMAT(DATE(INT(pmYM/100),MOD(pmYM,100),1),"mmm yyyy"))
VAR resultText = SWITCH(TRUE(),
    ISBLANK(selectedYM) || ISBLANK(nowOrders),BLANK(),
    pmYM<minimumYM,"No comparison: no earlier data",
    selectedPartial,"No comparison: selected month partial",
    pmPartial,"No comparison: prior month partial",
    ISBLANK(pmOrders) || pmOrders=0,"No comparison: no prior matching sales",
    IF(change>=0,"+","") & FORMAT(change,"0.0%") & " vs " & label)
RETURN IF(ISBLANK(change),resultText,IF(change>=0,"▲ ","▼ ") & resultText)
VAR __valueYoYCompare = 
VAR change = IF(NOT selectedPartial && NOT pyPartial && NOT ISBLANK(nowSales),
    DIVIDE(nowSales-pySales,pySales))
VAR label = IF(NOT ISBLANK(pyYM),FORMAT(DATE(INT(pyYM/100),MOD(pyYM,100),1),"mmm yyyy"))
VAR resultText = SWITCH(TRUE(),
    ISBLANK(selectedYM) || ISBLANK(nowSales),BLANK(),
    pyYM<minimumYM,"No comparison: no earlier data",
    selectedPartial,"No comparison: selected month partial",
    pyPartial,"No comparison: prior month partial",
    ISBLANK(pySales) || pySales=0,"No comparison: no prior matching sales",
    IF(change>=0,"+","") & FORMAT(change,"0.0%") & " vs " & label)
RETURN IF(ISBLANK(change),resultText,IF(change>=0,"▲ ","▼ ") & resultText)
RETURN ROW("__card_SalesCompare", __valueSalesCompare, "__card_OrdersCompare", __valueOrdersCompare, "__card_YoYCompare", __valueYoYCompare),
__CardsFilter)