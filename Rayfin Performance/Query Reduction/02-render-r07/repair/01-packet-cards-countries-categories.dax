EVALUATE
UNION(
SELECTCOLUMNS(CALCULATETABLE(ROW("Sales", [Total Sales], "Profit", [Gross Profit], "Margin", [Gross Margin], "Orders", [Order Count], "Lines", [Order Lines], "AOV", [AOV], "SalesCompare", [Sales Compare Text], "OrdersCompare", [Orders Compare Text], "YoYCompare", [Sales YoY Compare Text], "Partial", [Partial Month Text], "SourceLastDate", [Source Last Date]), TREATAS({"2013-11"}, 'DimDate'[YearMonth])), "Slot", "cards", "Label", BLANK(), "BarSales", BLANK(), "BarMargin", BLANK(), "BarOrders", BLANK(), "Sales", [Sales], "Profit", [Profit], "Margin", [Margin], "Orders", [Orders], "Lines", [Lines], "AOV", [AOV], "SalesCompare", [SalesCompare], "OrdersCompare", [OrdersCompare], "YoYCompare", [YoYCompare], "Partial", [Partial], "SourceLastDate", IF(ISBLANK([SourceLastDate]), BLANK(), FORMAT([SourceLastDate], "yyyy-MM-dd"))),
SELECTCOLUMNS(TOPN(1001, SUMMARIZECOLUMNS('DimSalesTerritory'[SalesTerritoryCountry], TREATAS({"2013-11"}, 'DimDate'[YearMonth]), "Sales", [Total Sales], "Orders", IGNORE([Order Count]), "Margin", IGNORE([Gross Margin])), [Sales], 0, 'DimSalesTerritory'[SalesTerritoryCountry], 1), "Slot", "countries", "Label", 'DimSalesTerritory'[SalesTerritoryCountry], "BarSales", [Sales], "BarMargin", [Margin], "BarOrders", [Orders], "Sales", BLANK(), "Profit", BLANK(), "Margin", BLANK(), "Orders", BLANK(), "Lines", BLANK(), "AOV", BLANK(), "SalesCompare", BLANK(), "OrdersCompare", BLANK(), "YoYCompare", BLANK(), "Partial", BLANK(), "SourceLastDate", BLANK()),
SELECTCOLUMNS(TOPN(1001, SUMMARIZECOLUMNS('DimProductCategory'[EnglishProductCategoryName], TREATAS({"2013-11"}, 'DimDate'[YearMonth]), "Sales", [Total Sales], "Orders", IGNORE([Order Count]), "Margin", IGNORE([Gross Margin])), [Sales], 0, 'DimProductCategory'[EnglishProductCategoryName], 1), "Slot", "categories", "Label", 'DimProductCategory'[EnglishProductCategoryName], "BarSales", [Sales], "BarMargin", [Margin], "BarOrders", [Orders], "Sales", BLANK(), "Profit", BLANK(), "Margin", BLANK(), "Orders", BLANK(), "Lines", BLANK(), "AOV", BLANK(), "SalesCompare", BLANK(), "OrdersCompare", BLANK(), "YoYCompare", BLANK(), "Partial", BLANK(), "SourceLastDate", BLANK())
)
ORDER BY [Slot], [BarSales] DESC, [Label]