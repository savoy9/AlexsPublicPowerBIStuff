EVALUATE
TOPN(1001, SUMMARIZECOLUMNS('DimSalesTerritory'[SalesTerritoryCountry], TREATAS({"2013-11"}, 'DimDate'[YearMonth]), "Sales", [Total Sales], "Orders", IGNORE([Order Count]), "Margin", IGNORE([Gross Margin])), [Sales], 0, 'DimSalesTerritory'[SalesTerritoryCountry], 1)
ORDER BY [Sales] DESC, 'DimSalesTerritory'[SalesTerritoryCountry]