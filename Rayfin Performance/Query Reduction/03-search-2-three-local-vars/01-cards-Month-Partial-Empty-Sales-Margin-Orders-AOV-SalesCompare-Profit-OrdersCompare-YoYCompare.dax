DEFINE
MEASURE 'FactInternetSales'[AW Selected Month] = 
		(/* USER DAX BEGIN */
VAR ym=SELECTEDVALUE(DimDate[YearMonthKey]) RETURN IF(ISBLANK(ym),"Select one month",FORMAT(DATE(INT(ym/100),MOD(ym,100),1),"MMM yyyy"))
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Partial Badge] = 
		(/* USER DAX BEGIN */
COALESCE([Partial Month Text],"")
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Empty Text] = 
		(/* USER DAX BEGIN */
IF(COALESCE([Order Lines],0)=0,"No sales for this selection","")
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Card Sales] = 
		(/* USER DAX BEGIN */
VAR v=[Total Sales] RETURN IF(ISBLANK(v),"—",IF(ABS(v)>=1000000,FORMAT(v/1000000,"$0.0")&"M",IF(ABS(v)>=1000,FORMAT(v/1000,"$0.0")&"K",FORMAT(v,"$0.00"))))
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Card Margin] = 
		(/* USER DAX BEGIN */
VAR __marginCard = [Gross Margin] RETURN IF(ISBLANK(__marginCard),"—",FORMAT(__marginCard,"0.0%"))
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Card Orders] = 
		(/* USER DAX BEGIN */
VAR __ordersCard = [Order Count] RETURN IF(ISBLANK(__ordersCard),"—",FORMAT(__ordersCard,"#,0"))
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Card AOV] = 
		(/* USER DAX BEGIN */
VAR __aovCard = [AOV] RETURN IF(ISBLANK(__aovCard),"—",FORMAT(__aovCard,"$#,0.00"))
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Sales Compare] = 
		(/* USER DAX BEGIN */
VAR __salesMoMCard = [Sales MoM %] VAR __salesMoMText = [Sales Compare Text] RETURN IF(ISBLANK(__salesMoMCard),__salesMoMText,IF(__salesMoMCard>=0,"▲ ","▼ ")&__salesMoMText)
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW Orders Compare] = 
		(/* USER DAX BEGIN */
VAR __ordersMoMCard = [Orders MoM %] VAR __ordersMoMText = [Orders Compare Text] RETURN IF(ISBLANK(__ordersMoMCard),__ordersMoMText,IF(__ordersMoMCard>=0,"▲ ","▼ ")&__ordersMoMText)
/* USER DAX END */)
MEASURE 'FactInternetSales'[AW YoY Compare] = 
		(/* USER DAX BEGIN */
VAR __salesYoYCard = [Sales YoY %] VAR __salesYoYText = [Sales YoY Compare Text] RETURN IF(ISBLANK(__salesYoYCard),__salesYoYText,IF(__salesYoYCard>=0,"▲ ","▼ ")&__salesYoYText)
/* USER DAX END */)
VAR __CardsFilter = TREATAS({"2013-12"}, 'DimDate'[YearMonth])

EVALUATE
SUMMARIZECOLUMNS(__CardsFilter, "__card_Month", IGNORE('FactInternetSales'[AW Selected Month]), "__card_Partial", IGNORE('FactInternetSales'[AW Partial Badge]), "__card_Empty", IGNORE('FactInternetSales'[AW Empty Text]), "__card_Sales", IGNORE('FactInternetSales'[AW Card Sales]), "__card_Margin", IGNORE('FactInternetSales'[AW Card Margin]), "__card_Orders", IGNORE('FactInternetSales'[AW Card Orders]), "__card_AOV", IGNORE('FactInternetSales'[AW Card AOV]), "__card_SalesCompare", IGNORE('FactInternetSales'[AW Sales Compare]), "__card_Profit", IGNORE('FactInternetSales'[Gross Profit]), "__card_OrdersCompare", IGNORE('FactInternetSales'[AW Orders Compare]), "__card_YoYCompare", IGNORE('FactInternetSales'[AW YoY Compare]))