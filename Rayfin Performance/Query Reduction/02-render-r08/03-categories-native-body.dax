DEFINE
	MEASURE 'FactInternetSales'[AW Category Title] = 
		(/* USER DAX BEGIN */
IF(ISBLANK([Total Sales]),"No data for the current filters","What · Category — click to filter; right-click to drill through")
/* USER DAX END */)

	VAR __DS0FilterTable = 
		TREATAS({"2013-11"}, 'DimDate'[YearMonth])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'DimProductCategory'[EnglishProductCategoryName],
			__DS0FilterTable,
			"Total_Sales", 'FactInternetSales'[Total Sales],
			"Gross_Margin", IGNORE('FactInternetSales'[Gross Margin]),
			"Order_Count", IGNORE('FactInternetSales'[Order Count])
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(1001, __DS0Core, [Total_Sales], 0, 'DimProductCategory'[EnglishProductCategoryName], 1)

EVALUATE
__DS0PrimaryWindowed

ORDER BY
	[Total_Sales] DESC, 'DimProductCategory'[EnglishProductCategoryName]