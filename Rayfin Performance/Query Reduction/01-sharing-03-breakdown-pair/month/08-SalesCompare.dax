DEFINE
	MEASURE 'FactInternetSales'[AW Sales Compare] = 
		(/* USER DAX BEGIN */
IF(ISBLANK([Sales MoM %]),[Sales Compare Text],IF([Sales MoM %]>=0,"▲ ","▼ ")&[Sales Compare Text])
/* USER DAX END */)

	VAR __DS0FilterTable = 
		TREATAS({"2013-11"}, 'DimDate'[YearMonth])

EVALUATE
	SUMMARIZECOLUMNS(
		__DS0FilterTable,
		"AW Sales Compare", IGNORE('FactInternetSales'[AW Sales Compare])
	)