EVALUATE
VAR WindowStart = [Trend start month]
VAR WindowEnd = [Trend end month]
VAR Months = SELECTCOLUMNS(GENERATESERIES(0, 23), "Key", EDATE(WindowStart, [Value]))
VAR MonthFilter = TREATAS(FILTER(Months, [Key] <= WindowEnd), 'Trend Date'[Month Start])
RETURN SUMMARIZECOLUMNS('Trend Date'[Year Month], 'Trend Date'[Month Start], NONVISUAL(MonthFilter),
    "Sales", IGNORE([Trend Net sales EUR]), "Budget", IGNORE([Trend Budget EUR]),
    "ReturnsPct", IGNORE([Trend Returns & warranty %]), "OTD", IGNORE([Trend On-time delivery %])
)
ORDER BY 'Trend Date'[Month Start] ASC
