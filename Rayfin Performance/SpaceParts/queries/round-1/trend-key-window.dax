EVALUATE
VAR WindowStart = [Trend start month]
VAR WindowEnd = [Trend end month]
VAR Months = FILTER(ALL('Trend Date'[Year Month], 'Trend Date'[Month Start]), 'Trend Date'[Month Start] >= WindowStart && 'Trend Date'[Month Start] <= WindowEnd)
RETURN SUMMARIZECOLUMNS(
    'Trend Date'[Year Month], 'Trend Date'[Month Start],
    Months,
    "Sales", IGNORE([Trend Net sales EUR]),
    "Budget", IGNORE([Trend Budget EUR]),
    "ReturnsPct", IGNORE([Trend Returns & warranty %]),
    "OTD", IGNORE([Trend On-time delivery %])
)
ORDER BY 'Trend Date'[Month Start] ASC
