EVALUATE
VAR WindowStart = [Trend start month]
VAR WindowEnd = [Trend end month]
VAR Grain = SUMMARIZE(FILTER(ALL('Trend Date'), 'Trend Date'[Month Start] >= WindowStart && 'Trend Date'[Month Start] <= WindowEnd), 'Trend Date'[Year Month], 'Trend Date'[Month Start])
RETURN GENERATE(Grain, ROW(
    "Sales", [Trend Net sales EUR], "Budget", [Trend Budget EUR], "ReturnsPct", [Trend Returns & warranty %], "OTD", [Trend On-time delivery %]
))
ORDER BY 'Trend Date'[Month Start] ASC
